{
  "manifest_version": 3,
  "name": "灵感匣剪藏",
  "version": "1.0",
  "description": "把当前网页一键剪藏到「灵感匣」",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "剪藏到灵感匣",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
